# ==========================================
# LOADVANTA ENVIRONMENT CONFIGURATION
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/loadvanta

# Authentication & Security
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=loadvanta_cookie_secret_key_change_in_production

# Razorpay Online Payment Gateway (Test Mode Defaults)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Maps & Distance Calculations (Optional: Google Maps / Mapbox)
# When not set, the built-in precision Punjab & North India matrix engine handles road routing & detour calculation
MAPS_API_KEY=

# Transactional Email Provider (Optional: SMTP / Sendgrid)
# When not set, notifications are recorded in-app and logged
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@loadvanta.com

# File Storage Configuration (local / S3-compatible)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
